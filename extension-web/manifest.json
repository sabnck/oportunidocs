{
  "manifest_version": 3,
  "name": "OportuniDocs",
  "version": "1.0.0",
  "description": "Send PDFs to OportuniDocs for privacy-first local document workflows.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:47411/*",
    "http://127.0.0.1:47411/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OportuniDocs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
