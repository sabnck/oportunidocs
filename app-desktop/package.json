{
  "name": "oportunidocs",
  "version": "1.0.0",
  "description": "OportuniDocs - Local-first document editor by Henrique Fernandes",
  "main": "out/main/index.js",
  "author": "Henrique Fernandes | StudioElevatio.com",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win",
    "build:portable": "npm run build && electron-builder --win portable",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "pdf-lib": "^1.17.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "fabric": "^5.3.0",
    "zustand": "^4.5.2",
    "express": "^4.18.3",
    "cors": "^2.8.5",
    "multer": "^2.0.0",
    "tesseract.js": "^5.0.4",
    "lucide-react": "^0.383.0",
    "clsx": "^2.1.1",
    "react-dropzone": "^14.2.3",
    "react-colorful": "^5.6.1",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "framer-motion": "^11.1.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@types/fabric": "^5.3.6",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "tailwindcss": "^3.4.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "eslint": "^8.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.studioelevatio.oportunidocs",
    "productName": "OportuniDocs",
    "copyright": "Copyright 2025 Henrique Fernandes | StudioElevatio.com",
    "publish": null,
    "compression": "store",
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OportuniDocs"
    },
    "files": [
      "out/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}
